{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aureliosaraiva/mapa-maconaria/schemas/fonte.schema.json",
  "title": "Fonte (catálogo da Enciclopédia da Maçonaria)",
  "description": "Vocabulários de temas/ritos/potências/países/períodos em docs/taxonomia.md (validados por scripts/validar_fontes.py como aviso, não erro).",
  "type": "object",
  "required": ["id", "tipo", "categoria", "autores", "titulo", "ano", "idioma", "temas", "confiabilidade", "acesso", "status_verificacao"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "tipo": {"enum": ["livro", "capitulo", "artigo", "tese", "dissertacao", "documento", "ritual", "exposicao", "periodico", "site", "pagina", "verbete", "audiovisual", "acervo", "dataset"]},
    "categoria": {"enum": ["primaria_historica", "ritual_publicado", "oficial_potencia", "academica", "tese", "historiografia_maconica", "enciclopedia", "divulgacao", "eclesiastica", "antimaconica", "acervo_museu", "imprensa", "audiovisual"]},
    "autores": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "Nome completo; para obra institucional/anônima use a organização ou 'Anônimo'."},
    "titulo": {"type": "string", "minLength": 1},
    "titulo_traduzido": {"type": "string"},
    "ano": {"type": ["integer", "null"], "minimum": 1000, "maximum": 2100},
    "ano_original": {"type": ["integer", "null"]},
    "idioma": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "editora": {"type": "string"},
    "local": {"type": "string"},
    "periodico": {"type": "string"},
    "volume": {"type": "string"},
    "paginas": {"type": "string"},
    "url": {"type": ["string", "null"], "description": "Melhor URL de acesso ao conteúdo (texto aberto) ou registro."},
    "identificadores": {"type": "object", "additionalProperties": {"type": "string"}, "description": "doi, isbn, oclc, ia (Internet Archive), hathitrust, wikidata, handle..."},
    "temas": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "ritos": {"type": "array", "items": {"type": "string"}},
    "potencias": {"type": "array", "items": {"type": "string"}},
    "paises": {"type": "array", "items": {"type": "string"}},
    "periodos": {"type": "array", "items": {"type": "string"}},
    "confiabilidade": {"enum": ["A", "B", "C", "D"]},
    "acesso": {"enum": ["dominio_publico", "aberto", "oficial_publico", "comercial", "restrito", "impresso", "desconhecido"]},
    "licenca": {"type": ["string", "null"], "description": "CC-BY, domínio público (motivo), todos os direitos reservados..."},
    "status_verificacao": {"enum": ["pista", "conferido_web", "copiado", "fichado", "revisado"]},
    "acervo": {"type": "array", "items": {"type": "string"}, "description": "Arquivos no acervo privado: pdf/<id>.pdf, txt/<id>.txt, html/<id>.html"},
    "resumo": {"type": "string", "description": "2–4 frases PARAFRASEADAS sobre o conteúdo e a utilidade da fonte."},
    "observacoes": {"type": ["string", "null"]},
    "evidencias": {"type": "array", "items": {"type": "string"}, "description": "URLs que confirmam os metadados."},
    "lote": {"type": "string"}
  },
  "additionalProperties": false
}
